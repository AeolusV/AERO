{
  "name": "codex-micro-bar",
  "version": "0.1.0",
  "private": true,
  "author": "Aeolus",
  "repository": { "type": "git", "url": "https://github.com/AeolusV/AERO.git" },
  "homepage": "https://github.com/AeolusV/AERO#readme",
  "bugs": { "url": "https://github.com/AeolusV/AERO/issues" },
  "license": "SEE LICENSE IN LICENSE",
  "description": "A calm, customizable floating controller for Codex Desktop on Windows.",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "assets:tray": "node scripts/generate-tray-icon.cjs",
    "verify:tray": "electron scripts/verify-tray-icon.cjs",
    "dev": "concurrently -k \"vite --config vite.config.ts --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run assets:tray && npm run check && vite build --config vite.config.ts",
    "test": "node scripts/run-tests.cjs",
    "verify": "npm run test && npm run build",
    "test:wake-manager": "node scripts/wake-listener-manager.test.cjs",
    "test:wake-live": "node scripts/wake-listener-live-smoke.cjs",
    "test:wake-ui": "electron scripts/wake-settings-ui-smoke.cjs",
    "test:wake-runtime": "node scripts/wake-runtime-installer.test.cjs",
    "wake:enable-current-user": "electron scripts/enable-wake-current-user.cjs",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1",
    "start": "electron .",
    "package:portable": "npm run build && node scripts/package-portable.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^43.2.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
